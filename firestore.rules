rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // Single source of truth for school roles: /schools/{schoolId}/members/{uid}
    // Never trust client-writable profile role fields or custom role claims.
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isPlatformTeam() {
      return isAuthenticated() && request.auth.token.platform == true;
    }

    function memberPath(schoolId) {
      return /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid);
    }

    function isSchoolMember(schoolId) {
      return isAuthenticated() && exists(memberPath(schoolId));
    }

    function isSchoolAdmin(schoolId) {
      return isEmailVerified() &&
        isSchoolMember(schoolId) &&
        get(memberPath(schoolId)).data.role == 'admin';
    }

    function isSchoolTeacherOrAdmin(schoolId) {
      return isEmailVerified() &&
        isSchoolMember(schoolId) &&
        (get(memberPath(schoolId)).data.role == 'teacher' ||
         get(memberPath(schoolId)).data.role == 'admin');
    }

    function isTeacherOfClass(schoolId, classId) {
      return isEmailVerified() &&
        isSchoolMember(schoolId) &&
        get(memberPath(schoolId)).data.role == 'teacher' &&
        classId is string &&
        exists(/databases/$(database)/documents/schools/$(schoolId)/classes/$(classId)) &&
        get(/databases/$(database)/documents/schools/$(schoolId)/classes/$(classId)).data.teacherUid == request.auth.uid;
    }

    function isValidDrillEventType(evType) {
      return evType in [
        'role_claimed',
        'call112_confirmed',
        'cpr_started',
        'cpr_rate_sample',
        'cpr_stopped',
        'aed_confirmed',
        'crowd_controlled',
        'handover_generated',
        'run_ended'
      ];
    }

    // ===============================================================
    // 0. USER PROFILES, ONBOARDING DRAFTS & MEMBERSHIP INDEX
    // Client-writable onboardingDrafts hold workflow intent ONLY and
    // are never consulted for school permissions.
    // ===============================================================
    match /onboardingDrafts/{uid} {
      allow get, create, update: if isAuthenticated() &&
        request.auth.uid == uid &&
        request.resource.data.intendedRole in ['teacher', 'school_admin', 'student'];
      allow list, delete: if false;
    }

    match /users/{uid} {
      allow get: if isAuthenticated() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if isAuthenticated() &&
        request.auth.uid == uid &&
        !('role' in request.resource.data) &&
        !('platform' in request.resource.data);
      allow delete: if false;

      match /memberships/{schoolId} {
        allow get, list: if isAuthenticated() && request.auth.uid == uid;
        allow create, update: if isEmailVerified() &&
          (request.auth.uid == uid || isSchoolAdmin(schoolId));
        allow delete: if isSchoolAdmin(schoolId);
      }
    }

    // ===============================================================
    // 1. REAL EMERGENCY COLLECTIONS (Untouched safety invariant #1)
    // A session without mode:"drill" is always treated as real.
    // If mode == "drill", it MUST include schoolId, drillId, and runId.
    // ===============================================================
    match /squad_sessions/{sessionId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if
        (!('mode' in request.resource.data) ||
          (request.resource.data.mode == 'drill' &&
           request.resource.data.schoolId is string &&
           request.resource.data.drillId is string &&
           request.resource.data.runId is string));
      allow delete: if false;
    }

    match /paramedic_dockets/{docketId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if true;
      allow delete: if false;
    }

    // ===============================================================
    // 2. DRILL MODE SCHOOL HIERARCHY (/schools/{schoolId}/...)
    // ===============================================================
    match /schools/{schoolId} {
      allow get: if isSchoolMember(schoolId);
      allow list: if false; // Never list all schools on the client; directory search is server-side only
      allow create: if isEmailVerified() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 140 &&
        request.resource.data.verificationStatus in ['unverified', 'pending'];
      allow update: if isSchoolAdmin(schoolId) &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.verificationStatus == resource.data.verificationStatus;
      allow delete: if isSchoolAdmin(schoolId);

      // Members subcollection: sole source of truth for school roles
      match /members/{uid} {
        allow get, list: if isSchoolMember(schoolId);
        allow create, update, delete: if isSchoolAdmin(schoolId);
      }

      // Single-use HMAC-SHA256 invites: NEVER readable/listable by non-admins
      match /invites/{inviteId} {
        allow get, list: if isSchoolAdmin(schoolId);
        allow create: if isSchoolAdmin(schoolId) &&
          request.resource.data.codeHash is string &&
          request.resource.data.codeHash.size() >= 16 &&
          request.resource.data.role in ['teacher', 'admin', 'student'] &&
          request.resource.data.usedBy == null;
        allow update, delete: if isSchoolAdmin(schoolId);
      }

      // Nested Join Requests (/schools/{schoolId}/joinRequests/{uid})
      // - Teacher join requests can be approved ONLY by a school `admin` (Principal).
      // - Student join requests can be approved by the Teacher of that class or by a school `admin`.
      match /joinRequests/{uid} {
        allow get: if (isAuthenticated() && request.auth.uid == uid) || isSchoolTeacherOrAdmin(schoolId);
        allow list: if isSchoolTeacherOrAdmin(schoolId);
        allow create: if isEmailVerified() &&
          request.auth.uid == uid &&
          request.resource.data.uid == uid &&
          request.resource.data.schoolId == schoolId &&
          request.resource.data.requestedRole in ['teacher', 'student'] &&
          request.resource.data.status == 'pending';
        allow update: if
          (resource.data.requestedRole == 'teacher' && isSchoolAdmin(schoolId)) ||
          (resource.data.requestedRole == 'student' &&
            (isSchoolAdmin(schoolId) || isTeacherOfClass(schoolId, resource.data.targetClassId)));
        allow delete: if isSchoolAdmin(schoolId);
      }

      // Classes subcollection
      match /classes/{classId} {
        allow get, list: if isSchoolMember(schoolId);
        allow create, update: if isSchoolTeacherOrAdmin(schoolId) &&
          request.resource.data.name is string &&
          request.resource.data.grade is string &&
          request.resource.data.studentCount is int &&
          request.resource.data.studentCount >= 1 &&
          request.resource.data.studentCount <= 120;
        allow delete: if isSchoolAdmin(schoolId);

        // Pseudonymous Student Roster codes (S-01..S-40)
        match /students/{studentId} {
          allow get, list: if isSchoolMember(schoolId);
          allow create, update: if isSchoolTeacherOrAdmin(schoolId) &&
            request.resource.data.code is string &&
            request.resource.data.code.size() <= 16 &&
            (!('displayName' in request.resource.data) ||
             get(/databases/$(database)/documents/schools/$(schoolId)).data.settings.showStudentNames == true);
          allow delete: if isSchoolTeacherOrAdmin(schoolId);
        }
      }

      // Drills subcollection
      match /drills/{drillId} {
        // Active drills can be read by authenticated users (including anonymous quick-join students) by ID
        allow get: if isAuthenticated();
        allow list: if isSchoolMember(schoolId);
        allow create, update: if isSchoolTeacherOrAdmin(schoolId) &&
          request.resource.data.mode == 'drill' &&
          request.resource.data.scenarioId == 'cardiac-arrest-unresponsive' &&
          request.resource.data.status in [
            'draft', 'scheduled', 'ready', 'live', 'ended', 'completed', 'cancelled'
          ];
        allow delete: if isSchoolAdmin(schoolId);

        // Per-team Runs inside a Drill
        match /runs/{runId} {
          allow get: if isAuthenticated();
          allow list: if isSchoolMember(schoolId);
          allow create, update: if isSchoolTeacherOrAdmin(schoolId) ||
            (isAuthenticated() &&
             resource.data.status in ['waiting', 'live'] &&
             request.resource.data.teamMembers.size() <= 8);
          allow delete: if isSchoolAdmin(schoolId);

          // Drill-scoped Anonymous Participant Slot Binding (/participants/{anonUid})
          // Students are anonymous and never get a members/{uid} doc; they can write ONLY their own participant doc while the drill is active.
          match /participants/{anonUid} {
            allow get, list: if isAuthenticated();
            allow create, update: if isSchoolTeacherOrAdmin(schoolId) ||
              (isAuthenticated() &&
               request.auth.uid == anonUid &&
               get(/databases/$(database)/documents/schools/$(schoolId)/drills/$(drillId)).data.status in ['ready', 'live'] &&
               request.resource.data.studentCode is string &&
               request.resource.data.studentCode.size() <= 16);
            allow delete: if isSchoolTeacherOrAdmin(schoolId);
          }

          // Append-only, immutable Drill Events (/events/{eventId})
          // Anonymous students can write ONLY their own events (`actorUid == request.auth.uid`) while the drill is active or within the sync grace window.
          match /events/{eventId} {
            allow get, list: if isAuthenticated();
            allow create: if isAuthenticated() &&
              isValidDrillEventType(request.resource.data.type) &&
              request.resource.data.actorUid == request.auth.uid &&
              request.resource.data.studentCode is string &&
              request.resource.data.studentCode.size() <= 16 &&
              request.resource.data.clientAt is number &&
              (isSchoolTeacherOrAdmin(schoolId) ||
               get(/databases/$(database)/documents/schools/$(schoolId)/drills/$(drillId)).data.status in ['ready', 'live']);
            // Events are strictly immutable once written
            allow update, delete: if false;
          }
        }
      }

      // Aggregated Class Stats
      match /classStats/{classId} {
        allow get, list: if isSchoolMember(schoolId);
        allow create, update: if isSchoolTeacherOrAdmin(schoolId);
        allow delete: if isSchoolAdmin(schoolId);
      }

      // Aggregated School Stats
      match /schoolStats/{docId} {
        allow get, list: if isSchoolMember(schoolId);
        allow create, update: if isSchoolTeacherOrAdmin(schoolId);
        allow delete: if isSchoolAdmin(schoolId);
      }

      // Frozen Term Reports
      match /termReports/{termId} {
        allow get, list: if isSchoolMember(schoolId);
        allow create: if isSchoolAdmin(schoolId);
        allow update, delete: if false;
      }
    }

    // ===============================================================
    // 3. PUBLIC VERIFIABLE CERTIFICATES (/certificates/{certId})
    // Public `get` by unguessable certId ONLY (`list: if false` prevents scraping).
    // Never stores student names on public verification docs.
    // ===============================================================
    match /certificates/{certId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isAuthenticated() &&
        request.resource.data.schoolId is string &&
        isSchoolTeacherOrAdmin(request.resource.data.schoolId) &&
        !('studentName' in request.resource.data);
      allow delete: if false;
    }

    // ===============================================================
    // 4. PLATFORM PILOT AGGREGATES (/platformStats/{docId})
    // Restricted to Sanjeevani platform team (`request.auth.token.platform == true`)
    // ===============================================================
    match /platformStats/{docId} {
      allow get, list: if isPlatformTeam();
      allow write: if false;
    }
  }
}

